# Copy to backend/.env (never commit the real file).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# Set to "production" to require a real secret key.
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# MySQL is the target database (see docs/database.md). Either set DB_* variables
# (recommended when the password contains "@" or ":") or a single DATABASE_URL.
# If neither is set, a local SQLite file is used.
DB_NAME=football_fit
DB_USER=football_fit
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
# DATABASE_URL=mysql://football_fit:change-me@127.0.0.1:3306/football_fit
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional API throttling (DRF rate format).
API_ANON_RATE=120/min
API_USER_RATE=600/min
