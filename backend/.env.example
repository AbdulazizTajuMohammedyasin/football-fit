# Copy to backend/.env (never commit the real file).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# Set to "production" to require a real secret key.
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL is the target database. If unset, a local SQLite file is used for development.
DATABASE_URL=postgres://football_fit:football_fit@localhost:5432/football_fit
CORS_ALLOWED_ORIGINS=http://localhost:5173
